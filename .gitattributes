* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Language statistics: let GitHub Linguist detect code normally.
# Lockfiles, build output and docs are excluded so they do not skew the stats.
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
**/dist/** linguist-generated=true
docs/** linguist-documentation=true
